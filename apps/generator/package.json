{
  "name": "generator",
  "version": "2.0.0",
  "private": true,
  "description": "Glossary article generator server",
  "main": "dist/server.js",
  "scripts": {
    "dev": "dotenv -e .env -- tsx watch src/server.ts",
    "build": "tsc",
    "start": "tsx src/server.ts",
    "db:push": "dotenv -e .env drizzle-kit push",
    "db:studio": "dotenv -e .env drizzle-kit studio --verbose",
    "db:generate": "dotenv -e .env drizzle-kit generate",
    "db:migrate": "dotenv -e .env drizzle-kit migrate",
    "db:pull": "dotenv -e .env drizzle-kit pull"
  },
  "keywords": [],
  "author": "Andreas Thomas",
  "license": "ISC",
  "dependencies": {
    "@agentic/serper": "^7.0.0",
    "@ai-sdk/google": "^1.1.19",
    "@ai-sdk/openai": "^0.0.63",
    "@hono/node-server": "^1.13.8",
    "@mendable/firecrawl-js": "^1.5.2",
    "@octokit/rest": "^21.0.2",
    "@types/js-yaml": "^4.0.9",
    "@types/pg": "^8.11.6",
    "ai": "^4.3.9",
    "drizzle-orm": "^0.42.0",
    "drizzle-zod": "^0.7.1",
    "exa-js": "^1.4.10",
    "github-slugger": "^2.0.0",
    "hono": "^4.7.0",
    "js-yaml": "^4.1.0",
    "pg": "^8.13.0",
    "tsx": "^4.19.0",
    "zod": "^3.23.5"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "@types/node": "^20.14.9",
    "drizzle-kit": "^0.30.0",
    "typescript": "^5.5.3"
  }
}
